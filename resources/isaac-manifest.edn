{:id        :isaac.http
 :version   "0.1.21"
 :builtin?  true
 :factory   isaac.http.module/create-module

 :berths    {:isaac.http/identity {:description "Inbound request identity. Map contributions are data-shaped OIDC trust rules ({:issuer :jwks :audience :claims :principal}); :issuer, :audience and :claims values may be config refs — a vector path such as [:google :push :endpoint] resolved against live config, and a rule with an unresolved ref is inert. A symbol contribution is a code verifier (fn [request] -> {:name ... :scopes #{...}} | nil)."
                                      :schema {:type :map
                                               :key-spec {:type :keyword}
                                               :value-spec {:type :map
                                                            :factory isaac.http.auth/register-identity-entry!
                                                            :schema {:issuer {:type :any}
                                                                     :jwks {:type :string}
                                                                     :audience {:type :any}
                                                                     :claims {:type :any}
                                                                     :principal {:type :any}
                                                                     :factory {:type :symbol}}}}}
              :isaac.http/route {:description "HTTP routes. :path is a clout pattern (literal segments, :name params, * wildcards). :method is :get/:post/... or :* for any-method. Prefix matching is just a trailing wildcard in the path."
                                  :schema      {:type :seq
                                                :spec {:type    :map
                                                       :factory isaac.http.routes/register-route-entry!
                                                       :schema  {:method  {:type :keyword :validations [:present?]}
                                                                 :path    {:type :string :validations [:present?]}
                                                                 :handler {:type :symbol :validations [:present?]}
                                                                 :scope   {:type :keyword}}}}}
             :isaac.http/comm {:description "Communication channels (Discord, iMessage, ACP, …). Manifest contributions name available impls and carry the impl's :namespace (whose load implements isaac.comm.factory/create for that :type) plus its :extra-schema (extension fields composed into [:comms] slots of that :type). User-instantiated comm slots in the [:comms] config slot also count toward this berth, so `[:registered-in? :isaac.http/comm [:comms]]` accepts both manifest impl ids (the common :type values) and slot ids. :register-fn wires each live slot into comm-registry so the delivery worker can send outbound replies."
                                 :register-fn   isaac.comm.registry/register-instance!
                                 :deregister-fn isaac.comm.registry/deregister-instance!
                                 :schema      {:type       :map
                                               :key-spec   {:type :keyword}
                                               :value-spec {:type    :map
                                                            :schema  {:namespace     {:type :symbol :validations [:present?]}
                                                                      :extra-schema  {:type :schema-map}
                                                                      :send-schema   {:type :schema-map}
                                                                      :configurable? {:type :boolean}}}}}}

 :isaac/component {:server-runtime {:namespace isaac.http.component.runtime}
                   :http           {:namespace isaac.http.component.http}}

 :isaac/cli {:http {:usage     "http <subcommand> [options]"
                    :summary   "HTTP module: manage principals (auth mint|rotate|revoke|list)"
                    :namespace isaac.http.cli}
             :mcp-bridge {:usage     "mcp-bridge [options]"
                          :summary   "stdio MCP server that proxies a turn to POST /mcp/turns/{id}"
                          :namespace isaac.mcp-bridge.cli}}

 :isaac.config/check
 {:http-principals {:fn isaac.http.auth/validate-principals}}

 :isaac.config/schema
 {:http {:schema {:name        :http
                    :type        :map
                    :description "HTTP server configuration"
                    :schema      {:auth       {:type        :map
                                               :description "Server-wide inbound auth configuration"
                                               :schema      {:token {:type        :string
                                                                     :description "Bearer token for inbound HTTP requests"}
                                                             :principals {:type :map
                                                                          :key-spec {:type :id}
                                                                          :value-spec {:type :map
                                                                                       :schema {:hash {:type :string :validations [:present?]}
                                                                                                :scopes {:type :any :validations [:keyword-set?]}
                                                                                                :expires {:type :string}
                                                                                                :previous {:type :map
                                                                                                            :schema {:hash {:type :string :validations [:present?]}
                                                                                                                     :scopes {:type :any :validations [:keyword-set?]}
                                                                                                                     :expires {:type :string}}}}}}
                                                              :alerts {:type        :map
                                                                       :description "Auth attention alerts. Absent or true = on; false disables a kind."
                                                                       :schema      {:first-use {:type :boolean}
                                                                                     :expired   {:type :boolean}
                                                                                     :revoked   {:type :boolean}
                                                                                     :expiring  {:type :boolean}}}}}
                                  :oidc       {:type        :map
                                               :description "Generic OIDC/JWT verification knobs. Trust rules live on contributing modules."
                                               :schema      {:skew-s {:type :int :default 60 :coercions [[:default 60]] :description "Clock skew in seconds for exp/nbf/iat"}
                                                             :jwks-cache-s {:type :int :default 3600 :coercions [[:default 3600]] :description "JWKS cache TTL in seconds"}}}
                                  :burst      {:type        :map
                                               :description "Unauthenticated burst control. On by default; :enabled false turns it off."
                                               :default     {:enabled true :threshold 10 :window-ms 60000 :cooldown-ms 600000 :throttle? true :notify? true}
                                               :coercions   [[:default {:enabled true :threshold 10 :window-ms 60000 :cooldown-ms 600000 :throttle? true :notify? true}]]
                                               :schema      {:enabled     {:type :boolean :default true :coercions [[:default true]] :description "Master switch; false disables burst control"}
                                                             :threshold   {:type :int :default 10 :coercions [[:default 10]] :description "Unauthenticated responses that trip a burst"}
                                                             :window-ms   {:type :int :default 60000 :coercions [[:default 60000]] :description "Sliding window in milliseconds"}
                                                             :cooldown-ms {:type :int :default 600000 :coercions [[:default 600000]] :description "Quiet period that ends a burst"}
                                                             :notify?     {:type :boolean :default true :coercions [[:default true]] :description "Post attention on burst start and end"}
                                                             :throttle?   {:type :boolean :default true :coercions [[:default true]] :description "Answer flagged clients with 429"}}}
                                  :host  {:type :string :description "Bind host"}
                                  :port  {:type :int :description "Bind port"}}}}

  :comms {:schema {:name        "comms table"
                   :type        :map
                   :description "Communication channel configurations (map of name -> comm config)"
                   :key-spec    {:type :id}
                   :value-spec  {:name           :comm
                                 :type           :map
                                 :factory        isaac.comm.factory/create!
                                 :dynamic-schema {:berth :isaac.http/comm :path [:extra-schema]}
                                 :schema         {:type {:type         :id
                                                         :options-from :comms
                                                         :description  "Manifest comm kind to instantiate"
                                                         :validations  [[:registered-in? :isaac.http/comm [:comms]]]}
                                                  :crew {:type        :id
                                                         :description "Crew id this comm routes into"
                                                         :validations [:crew-exists?]}}}}}}}