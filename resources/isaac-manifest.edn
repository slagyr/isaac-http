{:id        :isaac.http
 :version   "0.1.25"
 :builtin?  true
 :factory   isaac.http.module/create-module
 :handbook  "isaac/http/handbook.md"

 :berths    {:isaac.http/identity {:description "Inbound request identity. Map contributions are data-shaped OIDC trust rules ({:issuer :jwks :audience :claims :principal}); :issuer, :audience and :claims values may be config refs — a vector path such as [:google :push :endpoint] resolved against live config, and a rule with an unresolved ref is inert. A symbol contribution is a code verifier (fn [request] -> {:name ... :scopes #{...}} | nil)."
                                      :schema {:type :map
                                               :key-spec {:type :keyword}
                                               :value-spec {:type :map
                                                            :factory isaac.http.auth/register-identity-entry!
                                                            :schema {:issuer {:type :any}
                                                                     :jwks {:type :string}
                                                                     :audience {:type :any}
                                                                     :claims {:type :any}
                                                                     :principal {:type :any}
                                                                     :factory {:type :symbol}}}}}
              :isaac.http/route {:description "HTTP routes. :path is a clout pattern (literal segments, :name params, * wildcards). :method is :get/:post/... or :* for any-method. Prefix matching is just a trailing wildcard in the path."
                                  :schema      {:type :seq
                                                :spec {:type    :map
                                                       :factory isaac.http.routes/register-route-entry!
                                                       :schema  {:method  {:type :keyword :validations [:present?]}
                                                                 :path    {:type :string :validations [:present?]}
                                                                 :handler {:type :symbol :validations [:present?]}
                                                                 :scope   {:type :keyword}}}}}}

 :isaac/component {:server-runtime {:namespace isaac.http.component.runtime}
                   :http           {:namespace isaac.http.component.http}}

 :isaac/cli {:http {:usage     "http <subcommand> [options]"
                    :summary   "HTTP module: manage principals (auth mint|rotate|revoke|list)"
                    :namespace isaac.http.cli}}

 :isaac.config/check
 {:http-principals {:fn isaac.http.auth/validate-principals}
  :http-identity   {:fn isaac.http.auth/validate-identity-rules}}

 :isaac.config/schema
 {:http {:schema {:name        :http
                    :type        :map
                    :description "HTTP server configuration"
                    :schema      {:auth       {:type        :map
                                               :description "Server-wide inbound auth configuration"
                                               :schema      {:token {:type        :string
                                                                     :description "Bearer token for inbound HTTP requests"}
                                                             :principals {:type :map
                                                                          :description "Named bearer-token principals, keyed by principal name; each holds only a secret hash, never the secret itself. Managed via `isaac http auth mint|rotate|revoke|list`."
                                                                          :key-spec {:type :id}
                                                                          :value-spec {:type :map
                                                                                       :schema {:hash {:type :string :validations [:present?] :description "SHA-256 hash (sha256:<hex>) of the principal's bearer secret"}
                                                                                                :scopes {:type :any :validations [:keyword-set?] :description "Scopes this principal may use; #{:*} grants every scope"}
                                                                                                :expires {:type :string :description "ISO date (YYYY-MM-DD) or instant after which this principal is refused"}
                                                                                                :previous {:type :map
                                                                                                            :description "Prior secret kept valid through a rotation overlap window"
                                                                                                            :schema {:hash {:type :string :validations [:present?] :description "SHA-256 hash of the overlapping prior secret"}
                                                                                                                     :scopes {:type :any :validations [:keyword-set?] :description "Scopes carried over from the rotated principal"}
                                                                                                                     :expires {:type :string :description "When the overlap window ends and the prior secret stops working"}}}}}}
                                                              :identity {:type        :map
                                                                         :description "Operator-declared OIDC trust rules, keyed by rule id. Same data shape modules contribute at :isaac.http/identity; a rule here with a registered rule's id replaces it. Values may be config refs (a vector path resolved against live config)."
                                                                         :key-spec    {:type :id}
                                                                         :value-spec  {:type :map
                                                                                       :schema {:issuer    {:type :any :description "Issuer the JWT's iss must equal"}
                                                                                                :jwks      {:type :any :description "JWKS document URL for the issuer's signing keys"}
                                                                                                :audience  {:type :any :description "Audience the JWT's aud must contain"}
                                                                                                :claims    {:type :any :description "Claims the JWT must match exactly"}
                                                                                                :principal {:type :map
                                                                                                            :description "Identity a matching JWT is accepted as"
                                                                                                            :schema {:name    {:type :keyword :validations [:present?] :description "Principal name a matching JWT authenticates as"}
                                                                                                                     :scopes  {:type :any :validations [:keyword-set?] :description "Scopes granted to a JWT that matches this rule"}
                                                                                                                     :expires {:type :string :description "ISO date or instant after which this rule's principal is refused"}}}}}}
                                                              :alerts {:type        :map
                                                                       :description "Auth attention alerts. Absent or true = on; false disables a kind."
                                                                       :schema      {:first-use {:type :boolean :description "Post attention the first time a principal is ever used"}
                                                                                     :expired   {:type :boolean :description "Post attention when an expired secret is presented"}
                                                                                     :revoked   {:type :boolean :description "Post attention when a revoked (removed) secret is presented"}
                                                                                     :expiring  {:type :boolean :description "Post attention once a day for a principal expiring within 7 days"}}}}}
                                  :oidc       {:type        :map
                                               :description "Generic OIDC/JWT verification knobs. Trust rules live on contributing modules."
                                               :default     {}
                                               :coercions   [[:default {}]]
                                               :schema      {:skew-s {:type :int :default 60 :coercions [[:default 60]] :description "Clock skew in seconds for exp/nbf/iat"}
                                                             :jwks-cache-s {:type :int :default 3600 :coercions [[:default 3600]] :description "JWKS cache TTL in seconds"}
                                                             :jwks-alert-threshold {:type :int :default 1 :coercions [[:default 1]] :description "Consecutive JWKS-unreachable refusals before posting an attention alert"}}}
                                  :burst      {:type        :map
                                               :description "Unauthenticated burst control. On by default; :enabled false turns it off."
                                               :default     {:enabled true :threshold 10 :window-ms 60000 :cooldown-ms 600000 :throttle? true :notify? true}
                                               :coercions   [[:default {:enabled true :threshold 10 :window-ms 60000 :cooldown-ms 600000 :throttle? true :notify? true}]]
                                               :schema      {:enabled     {:type :boolean :default true :coercions [[:default true]] :description "Master switch; false disables burst control"}
                                                             :threshold   {:type :int :default 10 :coercions [[:default 10]] :description "Unauthenticated responses that trip a burst"}
                                                             :window-ms   {:type :int :default 60000 :coercions [[:default 60000]] :description "Sliding window in milliseconds"}
                                                             :cooldown-ms {:type :int :default 600000 :coercions [[:default 600000]] :description "Quiet period that ends a burst"}
                                                             :notify?     {:type :boolean :default true :coercions [[:default true]] :description "Post attention on burst start and end"}
                                                             :throttle?   {:type :boolean :default true :coercions [[:default true]] :description "Answer flagged clients with 429"}}}
                                  :host  {:type :string :description "Bind host"}
                                  :port  {:type :int :description "Bind port"}}}}
  ;; isaac-mdj2: this retired-migration shim used to live in isaac-foundation
  ;; (schema_base.clj); foundation's tip dropped it with no replacement, and
  ;; isaac-http is the natural owner of five of its six pointers (the
  ;; :http-bound settings it migrated from :server). Restored here, verbatim,
  ;; so the existing "retired server X points at http X" behavior (and the
  ;; features covering it) keeps working.
  :server {:schema {:type        :map
                    :description "Retired HTTP/process settings"
                    :schema      {:auth               {:type   :map
                                                        :description "Retired; use :http :auth"
                                                        :schema {:token {:type        :string
                                                                        :description "Retired; use :http :auth :token"
                                                                        :validations [[:retired? "use :http :auth :token"]]}}}
                                  :burst              {:type        :map
                                                       :description "Retired; use :http :burst"
                                                       :validations [[:retired? "use :http :burst"]]}
                                  :host               {:type        :string
                                                       :description "Retired; use :http :host"
                                                       :validations [[:retired? "use :http :host"]]}
                                  :hot-reload         {:type        :boolean
                                                       :description "Retired; use top-level :hot-reload"
                                                       :validations [[:retired? "use :hot-reload"]]}
                                  :port               {:type        :int
                                                       :description "Retired; use :http :port"
                                                       :validations [[:retired? "use :http :port"]]}
                                  :suspend-timeout-ms {:type        :int
                                                       :description "Retired; use :bridge :suspend-timeout-ms"
                                                       :validations [[:retired? "use :bridge :suspend-timeout-ms"]]}}}}}}